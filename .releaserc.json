{
    "branches": [
        "main"
    ],
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "bash .github/scripts/update-version.sh ${nextRelease.version}",
                "publishCmd": "echo \"VERSION=${nextRelease.version}\" >> $GITHUB_OUTPUT && echo \"NOTES<<EOF\" >> $GITHUB_OUTPUT && echo \"${nextRelease.notes}\" >> $GITHUB_OUTPUT && echo \"EOF\" >> $GITHUB_OUTPUT"
            }
        ]
    ]
}