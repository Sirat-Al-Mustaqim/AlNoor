<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme -->
    <style name="Theme.AlNoor" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash Screen theme using SplashScreen compat library (works on API 23+) -->
    <style name="Theme.AlNoor.Splash" parent="Theme.SplashScreen">
        <!-- Background color for splash screen -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Center icon displayed during splash -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_noor_shield</item>
        <!-- Set icon background on 12+ for proper sizing -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <!-- Duration to keep the splash icon visible (in ms) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Theme to apply after splash completes -->
        <item name="postSplashScreenTheme">@style/Theme.AlNoor</item>
    </style>
</resources>